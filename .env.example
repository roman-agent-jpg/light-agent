# ============ LLM (Antigravity мост) ============
AG_BASE_URL=https://agent-master-server.onrender.com/v1
AG_API_KEY=sk-antigravity-master-roman
AG_MODEL=antigravity-3.8-flash
AG_MODEL_FALLBACK=antigravity-3.8-pro

# ============ Фолбэк-провайдеры (необязательно) ============
# Если мост не отвечает — агент переключится сюда
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=

# ============ Supabase (память диалогов) ============
SUPABASE_URL=
SUPABASE_KEY=
# Management API: агент сам создаёт таблицы (agent_secrets и др.),
# обычный клиент supabase не умеет DDL. Токен НЕ хранить в репозитории.
SUPABASE_ACCESS_TOKEN=
# Ref проекта выводится из SUPABASE_URL автоматически, но можно задать явно
SUPABASE_PROJECT_REF=

# ============ Управление инфраструктурой ============
# С этими ключами агент может сам смотреть сервисы, менять переменные
# окружения и запускать деплои. API-ключи провайдеров хранятся в
# зашифрованном хранилище (таблица agent_secrets), а не здесь.
RENDER_API_KEY=
RENDER_OWNER_ID=

# ============ Хранилище секретов ============
# ADMIN_TOKEN — мастер-ключ шифрования: из него выводится ключ Fernet.
# Сменив ADMIN_TOKEN, старые секреты перестанут читаться.
ADMIN_TOKEN=

# ============ Storj S3 (файлы, 25 ГБ) ============
S3_ENDPOINT=https://gateway.storjshare.io
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=agent-files
S3_REGION=us-east-1

# ============ Anti-sleep ============
# Минуты простоя, после которых агент засыпает
IDLE_SLEEP_MINUTES=14
# Публичный URL этого сервиса (для внешнего keepalive)
SERVICE_URL=